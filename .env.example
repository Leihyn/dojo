# Public RPCs work for reads; set your own for indexing at scale.
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# 8004scan free API key (600 req/min vs 30 anonymous). Create at https://8004scan.io/developers
SCAN_API_KEY=

# Testnet-only key used to register reference agents and post graded feedback on ERC-8004 (chain 97).
# Never put a mainnet key here.
DEPLOYER_PRIVATE_KEY=

# Optional: enables LLM-assisted category classification. Rule-based classifier runs without it.
ANTHROPIC_API_KEY=

# Public base URL of the deployed marketplace; used in reference-agent cards and seed entries.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ERC-8004 agent keys (chainId:tokenId) assigned to the reference agents once registered on testnet.
DOJO_REF_KEY_VENUS_HEALTH=
DOJO_REF_KEY_VENUS_YIELD=
DOJO_REF_KEY_GRID_PLANNER=
DOJO_REF_KEY_RANGE_KEEPER=

# Server-side session key used by /api/activate to pay x402 endpoints on testnet. Never a mainnet key.
DOJO_SESSION_KEY=
